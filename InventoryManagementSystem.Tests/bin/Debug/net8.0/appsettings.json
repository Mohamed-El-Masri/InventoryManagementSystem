{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=InventoryManagementSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "ThisIsA_VeryLongAndSecureKeyForHS256Encryption_AtLeast32Chars",
    "Issuer": "InventoryManagementSystem",
    "Audience": "InventoryManagementSystemUsers",
    "ExpirationInMinutes": 60
  },
  "Hangfire": {
    "ArchiveTransactionsOlderThanDays": 365,
    "LowStockCheckFrequency": "0 0 * * *",
    "ArchiveTransactionsFrequency": "0 1 * * 0"
  }
}
